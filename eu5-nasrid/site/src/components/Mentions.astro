---
import DualDate from "./DualDate.astro";
import { url, mentions, EVENT_LABELS } from "../lib/site";

interface Props { kind: "people" | "places" | "wars"; id: string }
const { kind, id } = Astro.props;
const { story, events } = await mentions(kind, id);
---
<section class="mentions">
  <h2>In the chronicle</h2>
  {story.length ? (
    <ul>
      {story.map((s) => (
        <li><DualDate date={s.data.date} short /><a href={url(`/chronicle/${s.id}/`)}>{s.data.title}</a></li>
      ))}
    </ul>
  ) : <p class="ui empty">Not mentioned in the chronicle yet.</p>}

  <h2>In the event log</h2>
  {events.length ? (
    <ul class="ui">
      {events.map((e) => (
        <li><span class="meta">{e.data.date}, {EVENT_LABELS[e.data.type].toLowerCase()}</span><span>{e.data.title}</span></li>
      ))}
    </ul>
  ) : <p class="ui empty">No logged events yet.</p>}
</section>

<style>
  .mentions { max-width: 52rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: grid; grid-template-columns: 1fr; gap: 0.1rem 2rem; padding-block: 0.6rem; border-top: 1px solid var(--rule); }
  @media (min-width: 48rem) { li { grid-template-columns: 20rem 1fr; } }
  .empty { color: var(--muted); font-size: 0.95rem; }
</style>
