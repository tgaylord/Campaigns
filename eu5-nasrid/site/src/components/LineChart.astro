---
/**
 * A time-series line chart over game dates, rendered to SVG at build time,
 * with a crosshair tooltip added in the browser.
 *
 * One y-axis only. Two measures of different scale get two charts.
 */
import { gameDateToJd, parseDate, formatWestern } from "../lib/hijri";

export interface Point { date: string; value: number }
export interface Series { id: string; label: string; color: string; points: Point[] }
interface Props {
  title: string;
  series: Series[];
  yMin: number;
  yMax: number;
  yTicks?: number[];
  /** shaded y-ranges, e.g. a target zone */
  bands?: { from: number; to: number; label: string }[];
  /** horizontal reference lines */
  refs?: { value: number; label: string }[];
  unit?: string;
  height?: number;
  /** labels for the y-axis ends, e.g. Castile / Morocco */
  yEndLabels?: { low: string; high: string };
  /** drawing width; small multiples use a narrower canvas so their text stays legible */
  width?: number;
}
const {
  title, series, yMin, yMax, yTicks, bands = [], refs = [], unit = "", height = 240, yEndLabels, width = 720,
} = Astro.props;

const W = width;
const H = height;
const pad = { top: 16, right: series.length > 1 ? 120 : 24, bottom: 32, left: 48 };
const iw = W - pad.left - pad.right;
const ih = H - pad.top - pad.bottom;

const allPoints = series.flatMap((s) => s.points);
const jds = allPoints.map((p) => gameDateToJd(parseDate(p.date)));
let x0 = Math.min(...jds);
let x1 = Math.max(...jds);
if (x0 === x1) { x0 -= 182; x1 += 182; }
const x = (date: string) => pad.left + ((gameDateToJd(parseDate(date)) - x0) / (x1 - x0)) * iw;
const y = (v: number) => pad.top + (1 - (v - yMin) / (yMax - yMin)) * ih;

const ticks = yTicks ?? [yMin, (yMin + yMax) / 2, yMax];

// Year ticks: about five, on whole years
const yStart = parseDate(allPoints.reduce((a, p) => (p.date < a ? p.date : a), allPoints[0].date)).y;
const yEnd = parseDate(allPoints.reduce((a, p) => (p.date > a ? p.date : a), allPoints[0].date)).y + 1;
const span = Math.max(1, yEnd - yStart);
const stepY = [1, 2, 5, 10, 20, 25, 50, 100].find((s) => span / s <= 6) ?? 100;
// Short spans (under three years) get quarterly ticks instead of yearly ones.
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const timeTicks: { jd: number; label: string }[] = [];
if (x1 - x0 < 3 * 365) {
  for (let yr = yStart; yr <= yEnd; yr++) for (const m of [1, 4, 7, 10]) {
    const jd = gameDateToJd({ y: yr, m, d: 1 });
    if (jd >= x0 && jd <= x1) timeTicks.push({ jd, label: m === 1 ? String(yr) : `${MONTHS[m - 1]} ${yr}` });
  }
} else {
  for (let yr = Math.ceil(yStart / stepY) * stepY; yr <= yEnd; yr += stepY) {
    const jd = gameDateToJd({ y: yr, m: 1, d: 1 });
    if (jd >= x0 && jd <= x1) timeTicks.push({ jd, label: String(yr) });
  }
}

const path = (pts: Point[]) =>
  pts.map((p, i) => `${i ? "L" : "M"}${x(p.date).toFixed(1)},${y(p.value).toFixed(1)}`).join("");

const fmt = (v: number) => `${v}${unit}`;
const payload = JSON.stringify({
  series: series.map((s) => ({
    label: s.label, color: s.color,
    points: s.points.map((p) => ({ x: x(p.date), y: y(p.value), date: formatWestern(p.date), value: fmt(p.value) })),
  })),
  left: pad.left, right: W - pad.right, top: pad.top, bottom: H - pad.bottom, width: W,
});
---
<figure class="chart">
  <figcaption class="visually-hidden">{title}</figcaption>
  {series.length > 1 && (
    <ul class="legend">
      {series.map((s) => <li><span class="key" style={`background:${s.color}`}></span>{s.label}</li>)}
    </ul>
  )}
  <div class="plot" data-chart={payload}>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
      {bands.map((b) => (
        <g>
          <rect x={pad.left} width={iw} y={y(b.to)} height={y(b.from) - y(b.to)} fill="var(--band)" />
          <text x={pad.left + 6} y={y(b.to) + 14} class="band-label">{b.label}</text>
        </g>
      ))}
      {ticks.map((t) => (
        <g>
          <line x1={pad.left} x2={W - pad.right} y1={y(t)} y2={y(t)} stroke="var(--grid)" stroke-width="1" />
          <text x={pad.left - 8} y={y(t) + 4} text-anchor="end" class="tick">{fmt(t)}</text>
        </g>
      ))}
      {refs.map((r) => (
        <g>
          <line x1={pad.left} x2={W - pad.right} y1={y(r.value)} y2={y(r.value)} stroke="var(--baseline)" stroke-width="1" />
          <text x={pad.left + 6} y={y(r.value) - 6} class="ref-label">{r.label}</text>
        </g>
      ))}
      {yEndLabels && (
        <g>
          <text x={W - pad.right - 6} y={pad.top + 14} text-anchor="end" class="axis-end">Towards {yEndLabels.high}</text>
          <text x={W - pad.right - 6} y={H - pad.bottom - 8} text-anchor="end" class="axis-end">Towards {yEndLabels.low}</text>
        </g>
      )}
      <line x1={pad.left} x2={W - pad.right} y1={H - pad.bottom} y2={H - pad.bottom} stroke="var(--baseline)" stroke-width="1" />
      {timeTicks.map((t) => {
        const xx = pad.left + ((t.jd - x0) / (x1 - x0)) * iw;
        return <text x={xx} y={H - pad.bottom + 20} text-anchor="middle" class="tick">{t.label}</text>;
      })}
      {series.map((s) => (
        <g>
          <path d={path(s.points)} fill="none" stroke={s.color} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
          {s.points.map((p) => (
            <circle cx={x(p.date)} cy={y(p.value)} r="4" fill={s.color} stroke="var(--panel)" stroke-width="2" />
          ))}
          {series.length > 1 && (() => {
            const last = s.points[s.points.length - 1];
            return <text x={x(last.date) + 10} y={y(last.value) + 4} class="end-label">{s.label}</text>;
          })()}
        </g>
      ))}
      <line class="crosshair" x1="0" x2="0" y1={pad.top} y2={H - pad.bottom} stroke="var(--muted)" stroke-width="1" visibility="hidden" />
    </svg>
    <div class="tip" hidden></div>
  </div>
</figure>

<style>
  .chart { margin: 1rem 0 0; background: var(--panel); border-radius: 6px; padding: 1rem 1rem 0.75rem; }
  .plot { position: relative; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .tick { font-size: 12px; fill: var(--muted); font-variant-numeric: tabular-nums; }
  .end-label { font-size: 12px; fill: var(--ink-2); }
  .band-label, .ref-label { font-size: 11.5px; fill: var(--ink-2); }
  .axis-end { font-size: 11.5px; fill: var(--muted); }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin: 0 0 0.5rem; padding: 0; font-size: 0.85rem; color: var(--ink-2); }
  .key { display: inline-block; width: 14px; height: 2px; vertical-align: middle; margin-right: 0.4rem; border-radius: 1px; }
  .tip {
    position: absolute; pointer-events: none; z-index: 2;
    background: var(--ink); color: var(--plaster);
    font-size: 0.8rem; line-height: 1.4; padding: 0.4rem 0.6rem; border-radius: 4px;
    white-space: nowrap; transform: translate(-50%, -110%);
  }
</style>

<script>
  // Crosshair + tooltip: snaps to the nearest checkpoint.
  for (const plot of document.querySelectorAll<HTMLElement>(".plot[data-chart]")) {
    const cfg = JSON.parse(plot.dataset.chart!);
    const svg = plot.querySelector("svg")!;
    const hair = svg.querySelector<SVGLineElement>(".crosshair")!;
    const tip = plot.querySelector<HTMLElement>(".tip")!;
    const xs: number[] = [...new Set<number>(cfg.series.flatMap((s: any) => s.points.map((p: any) => p.x)))].sort((a, b) => a - b);

    const show = (clientX: number) => {
      const r = svg.getBoundingClientRect();
      const vx = ((clientX - r.left) / r.width) * cfg.width;
      if (vx < cfg.left - 20 || vx > cfg.right + 20) return hide();
      const nx = xs.reduce((a, b) => (Math.abs(b - vx) < Math.abs(a - vx) ? b : a), xs[0]);
      hair.setAttribute("x1", String(nx)); hair.setAttribute("x2", String(nx));
      hair.setAttribute("visibility", "visible");
      const rows = cfg.series
        .map((s: any) => ({ s, p: s.points.find((p: any) => p.x === nx) }))
        .filter((r: any) => r.p);
      if (!rows.length) return hide();
      tip.replaceChildren();
      const head = document.createElement("div");
      head.textContent = rows[0].p.date;
      head.style.opacity = "0.75";
      tip.append(head);
      for (const { s, p } of rows) {
        const line = document.createElement("div");
        line.textContent = cfg.series.length > 1 ? `${s.label}: ${p.value}` : p.value;
        tip.append(line);
      }
      const top = Math.min(...rows.map((r: any) => r.p.y));
      tip.style.left = `${(nx / cfg.width) * 100}%`;
      tip.style.top = `${(top / (svg.viewBox.baseVal.height)) * 100}%`;
      tip.hidden = false;
    };
    const hide = () => { hair.setAttribute("visibility", "hidden"); tip.hidden = true; };
    plot.addEventListener("pointermove", (e) => show(e.clientX));
    plot.addEventListener("pointerleave", hide);
  }
</script>
