---
/**
 * Granada's win conditions for the Battle for the Strait, checked against a snapshot.
 * Conditions (eu5db 1.4.5): independent; holds the Granada, Andalusia and Murcia
 * areas (directly or through subjects); influence over Granada between −50 and +50;
 * Granadan sovereignty above 50.
 */
interface Props { snapshot: any }
const { snapshot } = Astro.props;
const s = snapshot.strait;

type Check = { label: string; detail: string; state: "met" | "unmet" | "unknown" };
const checks: Check[] = [
  {
    label: "Independent",
    detail: snapshot.overlord ? `tributary of ${snapshot.overlord.country}` : "no overlord",
    state: snapshot.overlord ? "unmet" : "met",
  },
  {
    label: "Influence between −50 and +50",
    detail: `now ${s.influence > 0 ? "+" : ""}${s.influence} (${s.influence < 0 ? "towards Castile" : s.influence > 0 ? "towards Morocco" : "even"})`,
    state: Math.abs(s.influence) < 50 ? "met" : "unmet",
  },
  {
    label: "Sovereignty above 50",
    detail: `now ${s.sovereignty}`,
    state: s.sovereignty > 50 ? "met" : "unmet",
  },
  {
    label: "Hold Granada, Andalusia and Murcia",
    detail: "not yet read from saves",
    state: "unknown",
  },
];
const icon = { met: "✓", unmet: "✕", unknown: "?" };
const word = { met: "Met", unmet: "Not met", unknown: "Unknown" };
---
<div class="strait-status ui">
  <h3>The Strait: Granada's win conditions</h3>
  <ul>
    {checks.map((c) => (
      <li class={c.state}>
        <span class="icon" aria-hidden="true">{icon[c.state]}</span>
        <span class="label">{c.label}</span>
        <span class="detail">{word[c.state]}, {c.detail}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .strait-status { margin: 1.5rem 0; padding: 1rem 1.25rem; background: var(--panel); border-radius: 6px; max-width: 40rem; }
  h3 { margin: 0 0 0.6rem; font-size: 1rem; font-family: var(--sans); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 1.5rem 1fr; gap: 0 0.5rem; padding-block: 0.35rem; }
  .icon { font-weight: 700; text-align: center; }
  .met .icon { color: var(--zellij); }
  .unmet .icon { color: #c0392b; }
  :global(:root[data-theme="dark"]) .unmet .icon { color: #ef7d6e; }
  .unknown .icon { color: var(--muted); }
  .label { color: var(--ink); }
  .detail { grid-column: 2; font-size: 0.85rem; color: var(--muted); }
</style>
