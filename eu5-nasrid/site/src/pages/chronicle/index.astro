---
import Base from "../../layouts/Base.astro";
import DualDate from "../../components/DualDate.astro";
import { getCollection } from "astro:content";
import { url, storySorted } from "../../lib/site";
import { formatHijri, hijriYear, parseDate } from "../../lib/hijri";

const eras = (await getCollection("eras")).sort((a, b) => a.data.start.localeCompare(b.data.start));
const story = await storySorted();
const byEra = (id: string) => story.filter((s) => s.data.era.id === id);
const span = (start: string, end: string | null) =>
  `${hijriYear(start)}–${end ? hijriYear(end) : ""} AH (${parseDate(start).y}–${end ? parseDate(end).y : ""})`;
---
<Base title="Chronicle">
  <header class="prose">
    <h1>The Chronicle</h1>
    <p class="intro">
      The history of the Nasrid kingdom as its court recorded it, era by era. Notes in plain language,
      marked as notes, record what happened at the table rather than at court.
    </p>
  </header>

  {eras.length === 0 && <p>No eras yet. The first era opens with the first chronicle entry.</p>}

  {eras.map((era) => (
    <section class="era" id={`era-${era.id}`} aria-labelledby={`h-${era.id}`}>
      <header class="era-head">
        <h2 id={`h-${era.id}`}>{era.data.title}</h2>
        <p class="meta">{span(era.data.start, era.data.end)}{era.data.end ? "" : ", in progress"}</p>
        {era.data.summary && <p class="era-summary">{era.data.summary}</p>}
      </header>
      <ol class="entries">
        {byEra(era.id).map((s) => (
          <li class={s.data.kind}>
            <div class="when"><DualDate date={s.data.date} short /></div>
            <div>
              <a href={url(`/chronicle/${s.id}/`)}>{s.data.title}</a>
              {s.data.kind === "ooc" && <span class="badge ui">Note</span>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>

<style>
  .intro { font-size: var(--step-1); line-height: 1.45; color: var(--ink-2); }
  .era { margin-top: 3rem; max-width: 52rem; }
  .era-head h2 { margin: 0; }
  .era-summary { color: var(--ink-2); max-width: var(--measure); margin-top: 0.5rem; }
  .entries { list-style: none; padding: 0; margin: 1.25rem 0 0; }
  .entries li {
    display: grid; grid-template-columns: 1fr; gap: 0.1rem 2rem;
    padding-block: 0.75rem; border-top: 1px solid var(--rule);
  }
  @media (min-width: 48rem) { .entries li { grid-template-columns: 17rem 1fr; } }
  .when { font-size: 0.95rem; }
  .entries a { font-weight: 700; text-decoration: none; color: var(--ink); }
  .entries a:hover { color: var(--lapis); text-decoration: underline; }
  .ooc a { font-weight: 400; color: var(--ink-2); }
  .badge {
    font-size: 0.75rem; color: var(--ink-2); border: 1px solid var(--rule);
    border-radius: 3px; padding: 0 0.35rem; margin-left: 0.5rem; vertical-align: 0.15em;
  }
</style>
