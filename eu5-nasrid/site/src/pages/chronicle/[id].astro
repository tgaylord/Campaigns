---
import Base from "../../layouts/Base.astro";
import DualDate from "../../components/DualDate.astro";
import { getEntry, getEntries, render } from "astro:content";
import { url, storySorted } from "../../lib/site";

export async function getStaticPaths() {
  const story = await storySorted();
  return story.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: story[i - 1] ?? null, next: story[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const era = await getEntry(entry.data.era);
const people = await getEntries(entry.data.people);
const places = await getEntries(entry.data.places);
const wars = await getEntries(entry.data.wars);
const hasLinks = people.length + places.length + wars.length > 0;
---
<Base title={entry.data.title}>
  <article class={`entry ${entry.data.kind}`}>
    <header class="prose">
      <p class="meta ui">
        <a href={url(`/chronicle/#era-${entry.data.era.id}`)}>{era?.data.title}</a>
        {entry.data.kind === "ooc" && <span> · Note</span>}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="date">
        <DualDate date={entry.data.date} />
        {entry.data.endDate && <> to <DualDate date={entry.data.endDate} /></>}
      </p>
    </header>

    <div class="layout">
      <div class="prose body"><Content /></div>

      {hasLinks && (
        <aside class="ui" aria-label="In this entry">
          {people.length > 0 && <><h2>People</h2><ul>{people.map((p) => <li><a href={url(`/people/${p.id}/`)}>{p.data.name}</a></li>)}</ul></>}
          {places.length > 0 && <><h2>Places</h2><ul>{places.map((p) => <li><a href={url(`/places/${p.id}/`)}>{p.data.name}</a></li>)}</ul></>}
          {wars.length > 0 && <><h2>Wars</h2><ul>{wars.map((w) => <li><a href={url(`/wars/${w.id}/`)}>{w.data.name}</a></li>)}</ul></>}
          {entry.data.sources.length > 0 && <><h2>Sources</h2><ul class="meta">{entry.data.sources.map((s) => <li>{s === "player" ? "Trent's account" : `Checkpoint ${s}`}</li>)}</ul></>}
        </aside>
      )}
    </div>

    <nav class="pager ui" aria-label="Neighbouring entries">
      {prev ? <a href={url(`/chronicle/${prev.id}/`)}>Earlier: {prev.data.title}</a> : <span></span>}
      {next ? <a href={url(`/chronicle/${next.id}/`)}>Later: {next.data.title}</a> : <span></span>}
    </nav>
  </article>
</Base>

<style>
  .date { font-size: 1.05rem; margin-top: -0.25rem; }
  .layout { display: grid; gap: 2rem 4rem; grid-template-columns: 1fr; margin-top: 2rem; }
  @media (min-width: 64rem) { .layout { grid-template-columns: minmax(0, var(--measure)) 14rem; } }
  .body :global(p:first-of-type em:only-child) { color: var(--muted); }
  .ooc .body { font-family: var(--sans); font-size: 1.02rem; color: var(--ink-2); }
  aside h2 { font-size: 0.85rem; color: var(--muted); font-weight: 600; margin: 0 0 0.3rem; font-family: var(--sans); }
  aside ul { list-style: none; padding: 0; margin: 0 0 1.25rem; font-size: 0.95rem; }
  aside li { padding-block: 0.15rem; }
  .pager { display: flex; justify-content: space-between; gap: 2rem; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--rule); font-size: 0.95rem; }
</style>
