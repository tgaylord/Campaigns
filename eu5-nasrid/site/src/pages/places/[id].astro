---
import Base from "../../layouts/Base.astro";
import DualDate from "../../components/DualDate.astro";
import Mentions from "../../components/Mentions.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return (await getCollection("places")).map((place) => ({ params: { id: place.id }, props: { place } }));
}
const { place } = Astro.props;
const p = place.data;
---
<Base title={p.name}>
  <header class="prose">
    <h1>{p.name}</h1>
    <p class="sub">{p.nameGame} in the game, a {p.kind}</p>
  </header>
  <h2>In Nasrid hands</h2>
  {p.held.length ? (
    <ul class="held">
      {p.held.map((h) => <li><DualDate date={h.from} /> to {h.to ? <DualDate date={h.to} /> : "the present"}</li>)}
    </ul>
  ) : <p>Never held by the Nasrids, so far.</p>}
  {p.note && <p class="prose">{p.note}</p>}
  <Mentions kind="places" id={place.id} />
</Base>

<style>
  .sub { font-size: var(--step-1); color: var(--ink-2); margin-top: -0.25rem; }
  .held { padding-left: 1.2rem; }
</style>
