---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { url } from "../../lib/site";
import { parseDate } from "../../lib/hijri";

const places = (await getCollection("places")).sort((a, b) => a.data.name.localeCompare(b.data.name, "en"));
const held = (h: { from: string; to: string | null }[]) =>
  h.length ? h.map((x) => `${parseDate(x.from).y}–${x.to ? parseDate(x.to).y : ""}`).join(", ") : "Never held";
---
<Base title="Places">
  <header class="prose">
    <h1>Places</h1>
    <p class="intro">
      The gazetteer: every place the chronicle names, by its Arabic name, with the name the game gives it
      and the years it has been in Nasrid hands.
    </p>
  </header>
  {places.length ? (
    <table class="ui">
      <thead><tr><th>Name</th><th>In the game</th><th>Kind</th><th>Held</th></tr></thead>
      <tbody>
        {places.map((p) => (
          <tr>
            <td><a class="serif" href={url(`/places/${p.id}/`)}>{p.data.name}</a></td>
            <td>{p.data.nameGame}</td>
            <td>{p.data.kind[0].toUpperCase() + p.data.kind.slice(1)}</td>
            <td>{held(p.data.held)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : <p>No places recorded yet.</p>}
</Base>

<style>
  .intro { font-size: var(--step-1); line-height: 1.45; color: var(--ink-2); }
  .serif { font-family: var(--serif); font-size: 1.05rem; }
</style>
