---
import Base from "../layouts/Base.astro";
import LineChart from "../components/LineChart.astro";
import DualDate from "../components/DualDate.astro";
import { snapshotsSorted, eventsSorted } from "../lib/site";

const snaps = await snapshotsSorted();
const events = (await eventsSorted()).filter((e) => ["estate_change", "law_change", "reform"].includes(e.data.type));

// Each estate keeps one colour across every chart (colour follows the entity, never its rank).
const ORDER = ["crown", "nobles", "clergy", "burghers", "peasants", "tribes", "dhimmi", "cossacks"];
const color = (id: string) => `var(--s${(ORDER.indexOf(id) >= 0 ? ORDER.indexOf(id) : 7) + 1})`;

const ids = [...new Set(snaps.flatMap((s) => s.data.estates.map((e) => e.id)))]
  .sort((a, b) => ORDER.indexOf(a) - ORDER.indexOf(b));
const estates = ids.map((id) => {
  const name = snaps.flatMap((s) => s.data.estates).find((e) => e.id === id)!.name;
  const at = (s: (typeof snaps)[number]) => s.data.estates.find((e) => e.id === id);
  return {
    id, name,
    power: snaps.filter((s) => at(s)).map((s) => ({ date: s.data.date, value: at(s)!.power })),
    satisfaction: snaps.filter((s) => at(s)?.satisfaction != null).map((s) => ({ date: s.data.date, value: at(s)!.satisfaction! })),
  };
});
---
<Base title="Estates">
  <header class="prose">
    <h1>The crown and the estates</h1>
    <p class="intro">
      Who holds power in the kingdom, and how content they are with it. Each estate's share of power and its
      satisfaction at every checkpoint, with the reforms and quarrels that moved them.
    </p>
  </header>

  {snaps.length < 2 ? <p>The charts need at least two checkpoints.</p> : (
    <>
      <h2>Share of power</h2>
      <div class="multiples">
        {estates.map((e) => (
          <div>
            <h3>{e.name}</h3>
            <LineChart title={`${e.name}: share of power`} series={[{ id: e.id, label: e.name, color: color(e.id), points: e.power }]}
              yMin={0} yMax={60} yTicks={[0, 20, 40, 60]} unit="%" height={190} width={380} />
          </div>
        ))}
      </div>

      <h2>Satisfaction</h2>
      <p class="prose">The darker line at 50 is where an estate is content; below it, it grows restless.</p>
      <div class="multiples">
        {estates.filter((e) => e.satisfaction.length > 1).map((e) => (
          <div>
            <h3>{e.name}</h3>
            <LineChart title={`${e.name}: satisfaction`} series={[{ id: e.id, label: e.name, color: color(e.id), points: e.satisfaction }]}
              yMin={0} yMax={100} yTicks={[0, 50, 100]} refs={[{ value: 50, label: "" }]} height={190} width={380} />
          </div>
        ))}
      </div>

      <details class="table-view">
        <summary>Show the numbers as a table</summary>
        <table>
          <thead><tr><th>Checkpoint</th>{estates.map((e) => <th class="num">{e.name}</th>)}</tr></thead>
          <tbody>
            {snaps.map((s) => (
              <tr>
                <td>{s.data.date}</td>
                {estates.map((e) => {
                  const x = s.data.estates.find((y) => y.id === e.id);
                  return <td class="num">{x ? `${x.power}% / ${x.satisfaction ?? "n/a"}` : ""}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
        <p class="meta">Each cell is power share / satisfaction.</p>
      </details>
    </>
  )}

  <h2>What moved them</h2>
  {events.length ? (
    <ul class="moves">
      {events.map((e) => (
        <li><DualDate date={e.data.date} short /><span class="ui">{e.data.title}</span></li>
      ))}
    </ul>
  ) : <p>No estate events logged yet.</p>}
</Base>

<style>
  .intro { font-size: var(--step-1); line-height: 1.45; color: var(--ink-2); }
  .multiples { display: grid; gap: 1rem 1.5rem; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); }
  .multiples h3 { font-family: var(--sans); font-size: 0.95rem; margin: 0.5rem 0 0; color: var(--ink-2); }
  .moves { list-style: none; padding: 0; margin: 0; max-width: 52rem; }
  .moves li { display: grid; grid-template-columns: 1fr; gap: 0.1rem 2rem; padding-block: 0.6rem; border-top: 1px solid var(--rule); }
  @media (min-width: 48rem) { .moves li { grid-template-columns: 20rem 1fr; } }
</style>
