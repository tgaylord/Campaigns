---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { url } from "../../lib/site";
import { parseDate } from "../../lib/hijri";

const people = (await getCollection("people")).sort((a, b) => (a.data.born ?? "9999").localeCompare(b.data.born ?? "9999"));
const life = (b?: string, d?: string) => (b || d ? `${b ? parseDate(b).y : "?"}–${d ? parseDate(d).y : ""}` : "");
---
<Base title="People">
  <header class="prose">
    <h1>People</h1>
    <p class="intro">The house of Naṣr, its viziers and commanders, and the scholars who passed through the court.</p>
  </header>
  {people.length ? (
    <table class="ui">
      <thead><tr><th>Name</th><th>Roles</th><th>Lived</th></tr></thead>
      <tbody>
        {people.map((p) => (
          <tr>
            <td><a href={url(`/people/${p.id}/`)}>{p.data.name}</a></td>
            <td>{p.data.roles.join(", ")}</td>
            <td>{life(p.data.born, p.data.died)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : <p>No people recorded yet.</p>}
  <p class="meta later">A family tree of the Nasrids comes once there's a real dynasty to draw.</p>
</Base>

<style>
  .intro { font-size: var(--step-1); line-height: 1.45; color: var(--ink-2); }
  .later { margin-top: 1.5rem; }
</style>
