---
import Base from "../layouts/Base.astro";
import DualDate from "../components/DualDate.astro";
import StraitStatus from "../components/StraitStatus.astro";
import { getEntry } from "astro:content";
import { url, nf, compact, snapshotsSorted, storySorted, eventsSorted, EVENT_LABELS } from "../lib/site";

const snaps = await snapshotsSorted();
const now = snaps.at(-1);
const ruler = now ? await getEntry(now.data.ruler) : undefined;
const capital = now ? await getEntry(now.data.capital) : undefined;
const story = (await storySorted()).filter((s) => s.data.kind === "chronicle").slice(-3).reverse();
const events = (await eventsSorted()).slice(-6).reverse();

const excerpt = (body = "") =>
  body.replace(/^\*[^*]+\*\s*/m, "").replace(/\[([^\]]+)\]\([^)]+\)/g, "$1").replace(/\s+/g, " ").trim().slice(0, 220) + "…";
---
<Base title="Home">
  <section class="masthead" aria-labelledby="site-title">
    <p class="motto" lang="ar" dir="rtl">وَلَا غَالِبَ إِلَّا ٱللّٰه</p>
    <p class="motto-gloss">
      <em>Wa-lā ghāliba illā Allāh</em>: there is no victor but God. The motto of the Nasrid house,
      cut into the walls of the Alhambra thousands of times over.
    </p>
    <h1 id="site-title">The Nasrid Chronicle</h1>
    <p class="lede">The kingdom of Gharnāṭa from 1337: its sultans, its estates, its wars, and its long contest for the Strait.</p>
  </section>

  {now ? (
    <section class="now" aria-labelledby="now-title">
      <h2 id="now-title">The realm at the last checkpoint</h2>
      <p class="meta"><DualDate date={now.data.date} /></p>
      <dl class="facts ui">
        <div><dt>Sultan</dt><dd><a href={url(`/people/${now.data.ruler.id}/`)}>{ruler?.data.name}</a></dd></div>
        <div><dt>Standing</dt><dd>{now.data.overlord ? `Tributary of ${now.data.overlord.country}` : "Independent"}</dd></div>
        <div><dt>Capital</dt><dd><a href={url(`/places/${now.data.capital.id}/`)}>{capital?.data.name}</a></dd></div>
        <div><dt>Locations held</dt><dd>{now.data.locations}</dd></div>
        <div><dt>Population</dt><dd>{compact(now.data.population.total)}</dd></div>
        <div><dt>Treasury</dt><dd>{nf.format(now.data.economy.treasury)} ducats</dd></div>
        <div><dt>Levies</dt><dd>{nf.format(now.data.military.levies)}</dd></div>
        <div><dt>Regiments</dt><dd>{now.data.military.regiments}</dd></div>
      </dl>
      {now.data.strait?.active && <StraitStatus snapshot={now.data} />}
      <p class="ui more"><a href={url("/realm/")}>See the realm at every checkpoint</a></p>
    </section>
  ) : (
    <section class="now">
      <h2>No checkpoints yet</h2>
      <p>Add the first checkpoint save to see the realm here.</p>
    </section>
  )}

  <div class="two-col">
    <section aria-labelledby="latest-title">
      <h2 id="latest-title">Latest in the chronicle</h2>
      {story.length ? (
        <ol class="entries">
          {story.map((s) => (
            <li>
              <a class="entry-title" href={url(`/chronicle/${s.id}/`)}>{s.data.title}</a>
              <p class="meta"><DualDate date={s.data.date} /></p>
              <p class="excerpt">{excerpt(s.body)}</p>
            </li>
          ))}
        </ol>
      ) : <p>The chronicle has no entries yet.</p>}
    </section>

    <section aria-labelledby="events-title">
      <h2 id="events-title">Recent events</h2>
      {events.length ? (
        <ul class="events ui">
          {events.map((e) => (
            <li>
              <span class="ev-type">{EVENT_LABELS[e.data.type]}</span>
              <span class="ev-title">{e.data.title}</span>
              <span class="meta">{e.data.date}</span>
            </li>
          ))}
        </ul>
      ) : <p>No events logged yet.</p>}
    </section>
  </div>
</Base>

<style>
  .masthead { padding-block: 1.5rem 2.5rem; border-bottom: 1px solid var(--rule); }
  .motto {
    font-family: var(--arabic); font-weight: 700; color: var(--gold);
    font-size: clamp(2.6rem, 9vw, 5.5rem); line-height: 1.5; margin: 0;
    text-align: left;
  }
  .motto-gloss { color: var(--ink-2); max-width: 46ch; margin-top: 0.25rem; font-size: 1rem; }
  h1 { margin-top: 1.5rem; }
  .lede { font-size: var(--step-1); line-height: 1.45; max-width: 34ch; color: var(--ink-2); margin: 0; }

  .now h2 { margin-bottom: 0.25rem; }
  .facts {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 1rem 2rem; margin: 1.5rem 0;
  }
  .facts dt { font-size: 0.8rem; color: var(--muted); }
  .facts dd { margin: 0.15rem 0 0; font-size: 1.15rem; color: var(--ink); }
  .more { font-size: 0.95rem; }

  .two-col { display: grid; gap: 0 4rem; grid-template-columns: 1fr; }
  @media (min-width: 60rem) { .two-col { grid-template-columns: 3fr 2fr; } }

  .entries { list-style: none; padding: 0; margin: 0; }
  .entries li { padding-block: 1rem; border-bottom: 1px solid var(--rule); }
  .entry-title { font-size: var(--step-1); font-weight: 700; text-decoration: none; color: var(--ink); }
  .entry-title:hover { color: var(--lapis); }
  .entries .meta { margin: 0.2rem 0 0.4rem; }
  .excerpt { margin: 0; color: var(--ink-2); }

  .events { list-style: none; padding: 0; margin: 0; font-size: 0.95rem; }
  .events li { display: grid; grid-template-columns: 7rem 1fr; gap: 0 1rem; padding-block: 0.6rem; border-bottom: 1px solid var(--rule); }
  .ev-type { color: var(--muted); font-size: 0.85rem; padding-top: 0.1rem; }
  .events .meta { grid-column: 2; }
</style>
