{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{3,4}-\\d{2}-\\d{2}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "war_declared",
        "battle",
        "siege",
        "peace",
        "ruler_change",
        "birth",
        "death",
        "marriage",
        "estate_change",
        "law_change",
        "reform",
        "territory_change",
        "strait_change",
        "gc_change",
        "situation",
        "formable",
        "player_note"
      ]
    },
    "title": {
      "type": "string"
    },
    "people": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "collection"
            ]
          },
          {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "collection"
            ]
          }
        ]
      }
    },
    "places": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "collection"
            ]
          },
          {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "collection"
            ]
          }
        ]
      }
    },
    "wars": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "collection"
            ]
          },
          {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "collection"
            ]
          }
        ]
      }
    },
    "data": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "source": {
      "type": "string"
    },
    "sample": {
      "default": false,
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "type",
    "title",
    "source",
    "id"
  ]
}