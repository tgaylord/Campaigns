{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{3,4}-\\d{2}-\\d{2}$"
    },
    "checkpoint": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "ruler": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "collection": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "collection"
          ]
        },
        {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "collection": {
              "type": "string"
            }
          },
          "required": [
            "slug",
            "collection"
          ]
        }
      ]
    },
    "heir": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "collection": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "collection"
              ]
            },
            {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string"
                },
                "collection": {
                  "type": "string"
                }
              },
              "required": [
                "slug",
                "collection"
              ]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "regent": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "collection": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "collection"
              ]
            },
            {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string"
                },
                "collection": {
                  "type": "string"
                }
              },
              "required": [
                "slug",
                "collection"
              ]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "capital": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "collection": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "collection"
          ]
        },
        {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "collection": {
              "type": "string"
            }
          },
          "required": [
            "slug",
            "collection"
          ]
        }
      ]
    },
    "rank": {
      "type": "string"
    },
    "locations": {
      "type": "number"
    },
    "overlord": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "country": {
              "type": "string"
            },
            "type": {
              "type": "string"
            }
          },
          "required": [
            "country",
            "type"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "subjects": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "country",
          "type"
        ]
      }
    },
    "population": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number"
        },
        "cultures": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "religions": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "total",
        "cultures",
        "religions"
      ]
    },
    "estates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "power": {
            "type": "number"
          },
          "satisfaction": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "power",
          "satisfaction"
        ]
      }
    },
    "economy": {
      "type": "object",
      "properties": {
        "treasury": {
          "type": "number"
        },
        "income": {
          "type": "number"
        },
        "expenses": {
          "type": "number"
        },
        "debt": {
          "default": 0,
          "type": "number"
        }
      },
      "required": [
        "treasury",
        "income",
        "expenses"
      ]
    },
    "military": {
      "type": "object",
      "properties": {
        "levies": {
          "type": "number"
        },
        "regiments": {
          "type": "number"
        },
        "ships": {
          "type": "number"
        }
      },
      "required": [
        "levies",
        "regiments",
        "ships"
      ]
    },
    "wars": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "collection"
            ]
          },
          {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "collection"
            ]
          }
        ]
      }
    },
    "strait": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "active": {
              "type": "boolean"
            },
            "influence": {
              "type": "number"
            },
            "sovereignty": {
              "type": "number"
            },
            "yearsSubject": {
              "type": "number"
            }
          },
          "required": [
            "active",
            "influence",
            "sovereignty",
            "yearsSubject"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "goldenCentury": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "european": {
              "type": "number"
            },
            "colonial": {
              "type": "number"
            },
            "flashpoint": {
              "type": "number"
            }
          },
          "required": [
            "european",
            "colonial",
            "flashpoint"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "sample": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "checkpoint",
    "ruler",
    "capital",
    "rank",
    "locations",
    "overlord",
    "population",
    "estates",
    "economy",
    "military",
    "strait"
  ]
}