{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "nameGame": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "location",
              "province",
              "area",
              "region"
            ]
          },
          "held": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^\\d{3,4}-\\d{2}-\\d{2}$"
                },
                "to": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{3,4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "from"
              ]
            }
          },
          "note": {
            "type": "string"
          },
          "sample": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "nameGame",
          "kind"
        ]
      }
    },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "nameGame": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "location",
              "province",
              "area",
              "region"
            ]
          },
          "held": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^\\d{3,4}-\\d{2}-\\d{2}$"
                },
                "to": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{3,4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "from"
              ]
            }
          },
          "note": {
            "type": "string"
          },
          "sample": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "nameGame",
          "kind"
        ]
      }
    }
  ]
}